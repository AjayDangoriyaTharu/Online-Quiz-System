# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── MongoDB ───────────────────────────────────────────────
# Local:      mongodb://localhost:27017/quizsystem
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/quizsystem
MONGO_URI=mongodb://localhost:27017/quizsystem

# ── JWT ───────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_secret

# ── Admin Registration ────────────────────────────────────
# Users who provide this secret during registration get the admin role
ADMIN_SECRET=replace_with_admin_secret

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
